# Dependencies (will be installed in container)
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Git
.git/
.gitignore
.gitattributes

# Build artifacts (will be built in container)
dist/
build/
*.js
*.js.map

# Environment files (use Docker secrets/env)
.env
.env.*
.env.local
.env.development
.env.production

# IDE
.vscode/
.idea/
*.swp
*.swo

# Documentation
README.md
PLAN.md
ARCHITECTURE.md
docs/

# Docker files (not needed in image)
Dockerfile
docker-compose.yml
docker-compose.override.yml
.dockerignore

# Kubernetes manifests (not needed in image)
k8s/
helm/
*.yaml
!prisma/schema.prisma

# Testing
coverage/
.nyc_output/
*.test.ts
*.spec.ts
__tests__/
test/

# Logs
logs/
*.log

# OS
.DS_Store
Thumbs.db

# CI/CD
.github/
.gitlab-ci.yml
.circleci/

# Temporary files
*.tmp
*.temp
.cache/

# Prisma migrations (will run in container)
prisma/migrations/

# Redis dump
dump.rdb